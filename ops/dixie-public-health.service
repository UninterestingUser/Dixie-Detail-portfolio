# Checks https://api.dixiedetail.com/health through the tunnel and pings
# Healthchecks on success; started by dixie-public-health.timer. Installed
# to /etc/systemd/system by ops/deploy.sh.
[Unit]
Description=Dixie Detail public health check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/dixie-detail
# Non-secret settings only, including PUBLIC_HEALTH_URL.
EnvironmentFile=/srv/dixie-detail/.env
# The Bitwarden machine-account token, for the Healthchecks ping URL.
LoadCredentialEncrypted=bws-token:/etc/credstore.encrypted/dixie-bws-token.cred
UMask=0077
ExecStart=/srv/dixie-detail/ops/public-health.sh
TimeoutStartSec=3min
