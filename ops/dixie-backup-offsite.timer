# Runs dixie-backup-offsite.service at 2:45 AM Eastern every night
# (decisions 0070 and 0127). Persistent= runs a missed backup as soon as
# the host is back up.
[Unit]
Description=Dixie Detail nightly backup to Backblaze at 2:45 AM

[Timer]
OnCalendar=*-*-* 02:45:00 America/New_York
# 2:45 AM does not exist on the night clocks spring forward (the second
# Sunday in March, always the 8th to the 14th), so systemd would skip it.
# Run at 3:45 AM that day instead.
OnCalendar=Sun *-03-08..14 03:45:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
