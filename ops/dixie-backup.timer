# Runs dixie-backup.service every hour at 5 past (decision 0127). The 2:45 AM
# run to Backblaze is dixie-backup-offsite.timer. Persistent= runs a missed
# backup as soon as the host is back up.
[Unit]
Description=Dixie Detail hourly backup at 5 past

[Timer]
OnCalendar=*-*-* *:05:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
