# Installed to /etc/systemd/system by ops/deploy.sh. Expects the repository
# at /srv/dixie-detail.
[Unit]
Description=Dixie Detail Docker stack
Requires=docker.service
# The tunnel's firewall rules are in place before any container starts
# (decision 0125). Wants, not Requires: if they fail, the site still runs,
# and ops/check-tunnel-isolation.sh shows the gap.
Wants=network-online.target dixie-tunnel-firewall.service
After=docker.service network-online.target dixie-tunnel-firewall.service
# Never give up: after a power or internet cut, a start that fails (Bitwarden
# unreachable, a container not healthy) is tried again every minute until it
# works (decision 0125).
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/dixie-detail
# Non-secret settings only.
EnvironmentFile=/srv/dixie-detail/.env
# The only stored secret: the Bitwarden machine-account token. systemd
# decrypts it into $CREDENTIALS_DIRECTORY, in memory and readable only by
# this service.
LoadCredentialEncrypted=bws-token:/etc/credstore.encrypted/dixie-bws-token.cred
# /run/dixie-stack, on tmpfs. stack-start.sh writes the secret files here;
# systemd deletes it when the service stops.
RuntimeDirectory=dixie-stack
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/srv/dixie-detail/ops/stack-start.sh
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=15min
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
