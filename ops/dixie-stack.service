# Installed to /etc/systemd/system by ops/deploy.sh. Expects the repository
# at /srv/dixie-detail.
[Unit]
Description=Dixie Detail Docker stack
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/dixie-detail
# Non-secret settings only.
EnvironmentFile=/srv/dixie-detail/.env
# The only stored secret: the Bitwarden machine-account token. systemd
# decrypts it into $CREDENTIALS_DIRECTORY, in memory and readable only by
# this service.
LoadCredentialEncrypted=bws-token:/etc/credstore.encrypted/dixie-bws-token.cred
# /run/dixie-stack, on tmpfs. stack-start.sh writes the secret files here;
# systemd deletes it when the service stops.
RuntimeDirectory=dixie-stack
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/srv/dixie-detail/ops/stack-start.sh
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
