# Non-secret settings for the server. Copy to /srv/dixie-detail/.env and fill in.
# Never put a secret here: secrets live only in Bitwarden Secrets Manager.
#
# Read by Docker Compose, by systemd (EnvironmentFile=) and by ops/deploy.sh,
# so keep to plain KEY=value lines: no quotes, no spaces around "=", no
# comments on the same line as a value.

# Bitwarden Secrets Manager project "Dixie Detail" (an ID, not a secret).
BWS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Bitwarden server: US cloud. (EU cloud: https://vault.bitwarden.eu.) Required:
# bws fails under systemd without it.
BWS_SERVER_URL=https://vault.bitwarden.com

POSTGRES_DB=dixie
POSTGRES_USER=dixie

# Comma-separated host names the app answers to: the server's tailnet name
# (used by `tailscale serve`) and the public API host behind the tunnel.
DJANGO_ALLOWED_HOSTS=server.your-tailnet.ts.net,api.dixiedetail.com

# Where ops/deploy.sh pulls from, over SSH with the deploy key.
DEPLOY_REMOTE=git@github.com:UninterestingUser/Dixie-Detail.git
DEPLOY_BRANCH=main

# Nightly backups (ops/backup.sh). Dumps are kept in BACKUP_DIR; restic sends
# them to RESTIC_REPOSITORY through rclone. RCLONE_CONFIG is the rclone config
# file, encrypted with RCLONE_CONFIG_PASS.
BACKUP_DIR=/mnt/raid/Backups/dixie-detail
RESTIC_REPOSITORY=rclone:gdrive:dixie-detail-backups
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# The public health page, checked through the tunnel every 10 minutes
# (ops/public-health.sh).
PUBLIC_HEALTH_URL=https://api.dixiedetail.com/health

# Secrets in Bitwarden (project "Dixie Detail"), by name. Not set here.
#   POSTGRES_PASSWORD        database password (db and app containers)
#   DJANGO_SECRET_KEY        Django signing key (app container)
#   CLOUDFLARE_TUNNEL_TOKEN  tunnel token (cloudflared container)
#   DEPLOY_SSH_KEY           read-only GitHub deploy key, OpenSSH private key (ops/deploy.sh)
#   RESTIC_PASSWORD          restic repository password (ops/backup.sh, ops/restore-test.sh)
#   RCLONE_CONFIG_PASS       password that decrypts the rclone config (same scripts)
#   HEALTHCHECKS_BACKUP_URL  Healthchecks ping URL for the nightly backup (optional)
#   HEALTHCHECKS_PUBLIC_URL  Healthchecks ping URL for the public health check
