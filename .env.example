# Non-secret settings for the server. Copy to /srv/dixie-detail/.env and fill in.
# Never put a secret here: secrets live only in Bitwarden Secrets Manager.
#
# Read by Docker Compose, by systemd (EnvironmentFile=) and by ops/deploy.sh,
# so keep to plain KEY=value lines: no quotes, no spaces around "=", no
# comments on the same line as a value.

# Bitwarden Secrets Manager project "Dixie Detail" (an ID, not a secret).
BWS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Bitwarden server: US cloud. (EU cloud: https://vault.bitwarden.eu.) Required:
# bws fails under systemd without it.
BWS_SERVER_URL=https://vault.bitwarden.com

POSTGRES_DB=dixie
POSTGRES_USER=dixie

# Comma-separated host names the app answers to: the server's tailnet name
# (used by `tailscale serve`) and the public API host behind the tunnel.
# Each name is also trusted as https://NAME for signing in to the control app.
DJANGO_ALLOWED_HOSTS=server.your-tailnet.ts.net,api.dixiedetail.com

# Where ops/deploy.sh pulls from, over SSH with the deploy key.
DEPLOY_REMOTE=git@github.com:UninterestingUser/Dixie-Detail.git
DEPLOY_BRANCH=main

# Nightly backups (ops/backup.sh). Dumps are kept in BACKUP_DIR; restic sends
# them to RESTIC_REPOSITORY through rclone. RCLONE_CONFIG is the rclone config
# file, encrypted with RCLONE_CONFIG_PASS.
BACKUP_DIR=/mnt/raid/Backups/dixie-detail
RESTIC_REPOSITORY=rclone:gdrive:dixie-detail-backups
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# The public health page, checked through the tunnel every 10 minutes
# (ops/public-health.sh).
PUBLIC_HEALTH_URL=https://api.dixiedetail.com/health

# The two Google calendars the app syncs (decision 0098): each calendar's ID
# from its Google Calendar settings, under "Integrate calendar". Not secret.
# Empty until connected (docs/operations/connecting-the-google-calendars.md);
# the calendar sync then waits.
GOOGLE_CALENDAR_JOBS_ID=
GOOGLE_CALENDAR_TIME_OFF_ID=

# The public API (docs/reference/public-api.md). Each may be left empty for
# the default shown in brackets.
# The website's addresses, comma-separated with https:// and no trailing
# slash: the only origins a browser may call the public API from (CORS).
# Empty refuses every browser. Until the Phase 5 launch, add the staging
# site's own address, the Cloudflare Pages project's pages.dev address.
PUBLIC_API_CORS_ORIGINS=https://dixiedetail.com,https://www.dixiedetail.com,https://dixie-detail.pages.dev
# Minutes a website quote can be booked [120].
QUOTE_LIFETIME_MINUTES=
# Quote request photos (decision 0099): most per request [6], largest each
# may be as sent in MB [15], days kept after the request closes [90].
QUOTE_REQUEST_MAX_PHOTOS=
QUOTE_REQUEST_PHOTO_MAX_MB=
QUOTE_REQUEST_PHOTO_DAYS=
# Address lookup sessions (decision 0115): lookups one session allows [10],
# and minutes it lasts after it opens [30].
ADDRESS_LOOKUP_SESSION_LOOKUPS=
ADDRESS_LOOKUP_SESSION_MINUTES=
# Mobile numbers whose website bookings and requests are test records,
# comma-separated, 10 digits each. api_smoke_test books from the first.
TEST_PHONE_NUMBERS=
# A Google place ID of a public place inside the service area, which
# api_smoke_test books its test job at. Never a customer's address.
API_SMOKE_TEST_PLACE_ID=

# Not set here: VEHICLE_DATA_CACHE_DIR, the vehicle data import's download
# cache inside the app container (default /srv/vehicle-data). The one-off
# import container, and the monthly refresh (ops/vehicle-refresh.sh), mount
# the host folder /srv/dixie-vehicle-data there, which ops/deploy.sh creates
# (docs/operations/importing-vehicle-data.md).

# Secrets in Bitwarden (project "Dixie Detail"), by name. Not set here.
#   POSTGRES_PASSWORD        database password (db and app containers)
#   DJANGO_SECRET_KEY        Django signing key (app container)
#   CLOUDFLARE_TUNNEL_TOKEN  tunnel token (cloudflared container)
#   DEPLOY_SSH_KEY           read-only GitHub deploy key, OpenSSH private key (ops/deploy.sh)
#   RESTIC_PASSWORD          restic repository password (ops/backup.sh, ops/restore-test.sh)
#   RCLONE_CONFIG_PASS       password that decrypts the rclone config (same scripts)
#   HEALTHCHECKS_BACKUP_URL  Healthchecks ping URL for the nightly backup (optional)
#   HEALTHCHECKS_PUBLIC_URL  Healthchecks ping URL for the public health check
#   HEALTHCHECKS_VEHICLE_REFRESH_URL  Healthchecks ping URL for the monthly vehicle data refresh (optional)
#   HEALTHCHECKS_TAX_RATES_URL  Healthchecks ping URL for the morning sales tax rate check (optional)
#   GOOGLE_MAPS_SERVER_KEY   server-side Google Maps Platform key, Place Details and Routes (app container; optional)
#   GOOGLE_SERVICE_ACCOUNT_JSON  the calendar service account's JSON key (app and calendar-worker containers; optional until connected)
#   HEALTHCHECKS_CALENDAR_CHECK_URL  Healthchecks ping URL for the nightly calendar check (optional)
#   TURNSTILE_SECRET_KEY     Cloudflare Turnstile secret key, checks bookings and quote requests (app container; until it exists they are refused)
#   OFFLINE_REQUESTS_SIGNING_KEY  key Cloudflare signs replayed "request a time" forms with (app container; until it exists they are refused)
#   CLOUDFLARE_PAGES_DEPLOY_HOOK  the website's deploy hook URL, called when a pricebook version is published (app container; optional)
#   HEALTHCHECKS_OFFLINE_URL  Healthchecks ping URL for the offline requests check; a secret of the dixie-offline-replay Worker on Cloudflare only, never on the server (optional)
#
# Not set here either: the home base, Google's daily caps and the drive-time
# estimate. They are database settings, changed on the control app's
# Location settings screen.
