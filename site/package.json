{
  "name": "dixie-detail-site",
  "private": true,
  "type": "module",
  "description": "The Dixie Detail website: a static Astro site on Cloudflare Pages, with the booking flow (docs/reference/booking-flow.md).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node tests/serve.mjs",
    "check:prices": "node tests/no-browser-prices.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test": "npm run check:prices && npm run test:unit && npm run test:e2e",
    "build:test": "node tests/build-for-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "7.4.13",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1"
  }
}
