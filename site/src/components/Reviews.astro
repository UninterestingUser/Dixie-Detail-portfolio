---
// Real reviews the owner supplies (data/reviews.yaml), never written for
// the site. Without any, the section points to the Google reviews.
import { Image } from "astro:assets";
import backdrop from "../assets/photos/reviews-background.webp";
import { business, reviews } from "../lib/data.js";
import Icon from "./Icon.astro";
const { heading = "What Cleveland and Athens customers say", limit = 3 } = Astro.props;
const google = business.social_profiles.google_business_profile;
const shown = reviews.slice(0, limit);
---
<section class="reviews" id="reviews" aria-labelledby="reviews-heading">
  <Image class="backdrop" src={backdrop} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
  <div class="wrap">
    <div class="stack">
      <p class="eyebrow">Reviews</p>
      <h2 class="display" id="reviews-heading">{heading}</h2>
      <p style="margin:0;display:flex;gap:4px;align-items:center" aria-label="Five stars on Google"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></p>
      {google && <p style="margin:0;font-size:17px">Read every review, or leave one, on <a href={google}>Google</a>.</p>}
    </div>
    {shown.length > 0 && (
      <div class="review-grid">
        {shown.map((review) => (
          <figure class="review">
            <blockquote>“{review.text}”</blockquote>
            <figcaption><strong>{review.name}</strong> · {review.source || "Google review"}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
