---
// The four service cards (owner, 2026-11-18), 2 x 2 like the current
// dixiedetail.com: light blue, the title and a white "from" price box, the
// owner's text, and two buttons in the "How it works" style. A city page
// passes its own text for each card, by section anchor.
import { dollars, serviceSections } from "../lib/data.js";
const { texts = {} } = Astro.props;
const cards = (await serviceSections()).filter((card) => card.from);
---
<div class="service-cards">
  {cards.map((card) => (
    <article class="service-card">
      <div class="service-card-top">
        <h3>{card.title}</h3>
        <p class="price-box">from {dollars(card.from)}</p>
      </div>
      <p class="text">{texts[card.anchor] || card.card}</p>
      <div class="card-buttons">
        <a class="button" href="/book/">{card.button}</a>
        <a class="button outline" href={`/services/#${card.anchor}`}>More info</a>
      </div>
    </article>
  ))}
</div>
