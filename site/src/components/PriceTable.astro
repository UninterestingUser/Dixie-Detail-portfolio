---
// A service's prices for each class and size, as the published pricebook
// has them. Display only: every figure is the server's.
import { api, dollars } from "../lib/data.js";
const { service } = Astro.props;
const book = await api("services");
const classes = new Map(book.classes.map((item) => [item.id, item]));
const rows = service.priced.prices.map((cell) => {
  const vehicleClass = classes.get(cell.class_id);
  const size = vehicleClass && vehicleClass.sizes.find((item) => item.value === cell.size);
  return { name: vehicleClass ? vehicleClass.name : "", size: size ? size.label : "", price: dollars(cell.price) };
}).filter((row) => row.name);
const oneRow = new Set(rows.map((row) => row.price)).size === 1;
---
{oneRow ? (
  <p class="from" style="margin:0;font-size:18px">Price: <strong style="color:var(--navy);font-size:24px">{rows[0]?.price}</strong>{service.name === "Headlight Restoration" ? " for both headlights" : ""}</p>
) : (
  <table class="prices">
    <caption class="visually-hidden">{service.name} prices by vehicle</caption>
    <thead><tr><th scope="col">Vehicle</th><th scope="col">Price</th></tr></thead>
    <tbody>
      {rows.map((row) => <tr><th scope="row">{row.name}{row.size ? `, ${row.size}` : ""}</th><td>{row.price}</td></tr>)}
    </tbody>
  </table>
)}
<style>
  .prices { border-collapse: collapse; width: 100%; max-width: 520px; font-size: 16px; }
  .prices th, .prices td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .prices thead th { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--navy); }
  .prices tbody th { font-weight: 600; }
  .prices td { font-weight: 800; color: var(--navy); white-space: nowrap; }
</style>
