---
// Every page: the head (title, description, canonical address, sharing
// tags, structured data), the header, the footer. The site is on staging
// until the Phase 5 launch: public/_headers sends noindex and
// public/robots.txt blocks everything (website-and-seo.md).
// Archivo, trimmed and served with the site (src/styles/global.css). Text
// shows at once in a fallback font and swaps when it arrives, so the font
// never holds up the first screen.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import headerPhoto from "../assets/photos/page-header.webp";

const { title, description, path = Astro.url.pathname, solidHeader = true, jsonLd = [], heroHeader = false } = Astro.props;
const site = "https://dixiedetail.com";
const canonical = site + path;
// Every page but the homepage: the header photo fills the header area above
// the red line, under a 50% black shade (owner, 2026-11-18). It is the
// largest thing on the first screen, so it is preloaded, in sizes from a
// phone's to a 1920 screen's, lighter than the other photos since the shade
// hides the detail.
const HEADER_WIDTHS = [480, 750, 1080, 1440, 1920];
const header = heroHeader ? null : await getImage({ src: headerPhoto, widths: HEADER_WIDTHS, quality: 45, format: "webp" });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dixie Detail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/social.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141518" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {header && <link rel="preload" as="image" imagesrcset={header.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    {heroHeader ? <slot name="hero" /> : (
      <div class="page-top">
        <img class="page-top-photo" src={header.src} srcset={header.srcSet.attribute} sizes="100vw" alt="" width="2000" height="1165" fetchpriority="high" decoding="async" />
        <Header solid={solidHeader} />
        <slot name="top" />
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
