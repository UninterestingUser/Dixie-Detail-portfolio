# Cloudflare Pages response headers (docs/reference/website-and-seo.md).
# Staging: X-Robots-Tag keeps every page out of search until the Phase 5
# launch, which removes that line, along with robots.txt's Disallow.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
